# SIPEKA Backend Configuration
# Rename this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sistem_evaluasi_kinerja

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (optional for future use)
JWT_SECRET=your_secret_key_here_change_in_production

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=*
CORS_ORIGIN=*
